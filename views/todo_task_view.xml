<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 1. تصميم نموذج إدخال البيانات (Form View) -->
    <record id="view_todo_task_form" model="ir.ui.view">
        <name>todo.task.form</name>
        <model>todo.task</model>
        <arch type="xml">
            <form string="المهمة">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="deadline"/>
                        <field name="is_completed"/>
                    </group>
                    <group string="تفاصيل إضافية">
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </arch>
    </record>

    <!-- 2. تصميم جدول عرض المهام (Tree/List View) -->
    <record id="view_todo_task_tree" model="ir.ui.view">
        <name>todo.task.tree</name>
        <model>todo.task</model>
        <arch type="xml">
            <tree string="قائمة المهام">
                <field name="name"/>
                <field name="deadline"/>
                <field name="is_completed"/>
            </tree>
        </arch>
    </record>

    <!-- 3. أمر تشغيل الشاشات (Action) -->
    <record id="action_todo_task" model="ir.actions.act_window">
        <name>مهامي اليومية</name>
        <res_model>todo.task</res_model>
        <view_mode>tree,form</view_mode>
    </record>

    <!-- 4. إنشاء القوائم في شريط أودو العلوي (Menus) -->
    <menuitem id="menu_todo_root" name="تطبيق المهام" sequence="10"/>
    <menuitem id="menu_todo_task" name="المهام" parent="menu_todo_root" action="action_todo_task"/>
</odoo>
